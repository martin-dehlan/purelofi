# PureLofi environment variables — copy to .env and fill in.
# .env is git-ignored. Never commit real keys.

SUPABASE_URL=
SUPABASE_ANON_KEY=

POSTHOG_API_KEY=
# EU host recommended (GDPR): https://eu.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# Google sign-in (#38). OAuth client IDs are public; leave empty to hide the
# Google button. Web = the client Supabase checks tokens against.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
