<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older, including `adb backup`: the same rule as
     data_extraction_rules.xml. The Supabase session never goes into a
     backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
