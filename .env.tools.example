# PureLofi tooling secrets — copy to .env.tools and fill in.
#
# These are NOT bundled into the app. .env is listed under `assets:` in
# pubspec.yaml and ships inside the app bundle, which anyone can unzip; the
# service role key bypasses row-level security, so it must never go there.
# Only tool/ reads this file.

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
